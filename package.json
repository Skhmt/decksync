{
  "name": "decksync",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "prepare:data": "node --max-old-space-size=4096 scripts/prepare-data.js",
    "prepare:opencv": "node scripts/prepare-opencv.js",
    "prepare:hashes": "set DECKSYNC_HASH_ALL=1 && node scripts/prepare-hashes.js",
    "topup:hashes": "node scripts/topup-hashes.js",
    "rebuild:hashes": "node scripts/rebuild-hashes-offline.js",
    "predev": "npm run prepare:data && npm run prepare:opencv",
    "dev": "vite",
    "host": "vite --host",
    "prebuild": "npm run prepare:data && npm run prepare:opencv",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "sharp": "^0.35.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "^7.0.0"
  }
}